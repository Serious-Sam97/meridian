{
  "name": "@meridian/core",
  "version": "0.1.0",
  "description": "Redis-backed job queue engine: queues, workers, retries and stalled-job recovery",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-lua.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "ioredis": "^6.0.0"
  }
}
